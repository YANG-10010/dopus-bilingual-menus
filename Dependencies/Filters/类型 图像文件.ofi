<?xml version="1.0" encoding="UTF-8"?>
<filter desc="类型 图像文件" name="类型 图像文件">
	<clause item_type="files" match="yes" type="type" />
	<clause link="and" match="yes" type="name" wildcards="yes">*.(jpg|jpe|jpeg|jfif|gif|png|bmp|tif|tiff|psd|webp|heic|heif|avif|svg|ico|raw|cr2|cr3|nef|arw|dng)</clause>
</filter>
