<?xml version="1.0" encoding="UTF-8"?>
<filter desc="类型 文档文件" name="类型 文档文件">
	<clause item_type="files" match="yes" type="type" />
	<clause link="and" match="yes" type="name" wildcards="yes">*.(doc|dot|docx|dotx|xls|xlsb|xlsx|xltx|ppt|pps|pptx|ppsx|pdf|txt|md|rtf|csv|wps|et|dps)</clause>
</filter>
