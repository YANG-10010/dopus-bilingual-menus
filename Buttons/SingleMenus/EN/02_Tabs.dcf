	<button backcol="none" display="both" dropdown_glyph="yes" label_pos="right" textcol="none" type="menu">
		<label>Go to T&amp;ab</label>
		<icon1>#newmenu</icon1>
		<button backcol="none" display="both" hotkey_label="yes" textcol="none">
			<label>&amp;Last Tab</label>
			<hotkeys>
				<chord>
					<key>tab</key>
					<key>192,0</key>
				</chord>
			</hotkeys>
