		</function>
	</button>
	<button backcol="none" display="both" hotkey_label="yes" label_pos="right" textcol="none">
		<label>转到原始路径</label>
		<tip>转到当前标签打开的原始路径</tip>
		<hotkeys>
			<chord>
				<key>tab</key>
				<key>home</key>
			</chord>
		</hotkeys>
		<icon1>#goback</icon1>
		<function type="normal">
			<instruction>//Go INITIALDIR</instruction>
			<instruction>//Go TABSELECT home </instruction>
			<instruction>//Go TABLOCKDIR</instruction>
			<instruction>Go HOMEDIR USEQUALKEYS</instruction>
		</function>
	</button>
	<button backcol="none" display="both" hotkey_label="yes" label_pos="right" textcol="none">
		<label>转到标签的锁定路径</label>
		<tip>标签锁定时的路径</tip>
		<icon1>#formatlock</icon1>
		<function type="normal">
			<instruction>Go TABLOCKDIR</instruction>
		</function>
	</button>
	<button backcol="none" display="both" label_pos="right" textcol="none">
		<label>复制所有标签的路径</label>
		<icon1>#clipcopy</icon1>
		<function type="script">
			<instruction>@script JScript</instruction>
			<instruction>function OnClick(clickData)</instruction>
			<instruction>{</instruction>
			<instruction>	var lister = clickData.func.sourcetab.lister;</instruction>
			<instruction>	var fsu = DOpus.FSUtil;</instruction>
			<instruction>	var clip = &quot;&quot;;</instruction>
			<instruction>	for (var eTabs = new Enumerator(lister.tabs); !eTabs.atEnd(); eTabs.moveNext())</instruction>
			<instruction>	{</instruction>
			<instruction>		var path = fsu.Resolve(eTabs.item().path);</instruction>
			<instruction>		clip += path + &quot;\n&quot;;</instruction>
			<instruction>	}</instruction>
			<instruction>	DOpus.SetClip(clip);</instruction>
			<instruction>}</instruction>
		</function>
	</button>
	<button backcol="none" display="both" label_pos="right" separate="yes" textcol="none">
		<label>为所有标签创建快捷方式</label>
		<tip>为来源栏所有标签的路径创建快捷方式到目标栏</tip>
		<icon1>#clippasteshortcut</icon1>
		<function type="script">
			<instruction>@script JScript</instruction>
			<instruction>function OnClick(clickData)</instruction>
			<instruction>{</instruction>
			<instruction>	var cmd = clickData.func.command;</instruction>
			<instruction>	cmd.deselect = false;</instruction>
			<instruction>	var fsu = DOpus.FSUtil;</instruction>
			<instruction>	var lister = clickData.func.sourcetab.lister;</instruction>
			<instruction>	var tabs = lister.tabsleft;</instruction>
			<instruction>	if (clickData.func.sourcetab.right) </instruction>
			<instruction>		tabs = lister.tabsright;</instruction>
			<instruction>	</instruction>
			<instruction>	//dopusrt /info /desktop\pathlist.txt,paths</instruction>
			<instruction>	//Copy C:\123 MAKELINK TO /desktop</instruction>
			<instruction>	for (var eTabs = new Enumerator(tabs); !eTabs.atEnd(); eTabs.moveNext())</instruction>
			<instruction>	{</instruction>
			<instruction>		var path = fsu.Resolve(eTabs.item().path);</instruction>
			<instruction>		cmd.AddLine(&apos;Copy &quot;&apos;+path+&apos;&quot; MAKELINK WHENEXISTS=skip&apos;);</instruction>
			<instruction>	}</instruction>
			<instruction>	cmd.Run;</instruction>
			<instruction>}</instruction>
		</function>
	</button>
</button>
