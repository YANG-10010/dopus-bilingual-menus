			<function type="normal">
				<instruction>Select FROMCHECKS </instruction>
			</function>
		</button>
	</button>
	<button backcol="none" display="both" separate="yes" textcol="none" type="menu">
		<label>更多...</label>
		<tip>More..</tip>
		<icon1>#advancedselect</icon1>
		<button backcol="none" display="both" textcol="none">
			<label>选择前x个文件...</label>
			<tip>Select the first x files..</tip>
			<icon1>#selectinvert</icon1>
			<function type="normal">
				<instruction>SelectEx LINEAR FILES ITEMCOUNT={dlgstring|输入要选择的数量:|100} DESELECTNOMATCH MAKEVISIBLE</instruction>
			</function>
		</button>
		<button backcol="none" display="both" textcol="none">
