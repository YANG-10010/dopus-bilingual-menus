	<button backcol="none" display="both" textcol="none" type="menu">
		<label>双栏选择(&amp;S)</label>
		<icon1>#newmenu</icon1>
		<button backcol="none" display="both" label_pos="right" textcol="none">
			<label>来源 | 双栏都有</label>
			<tip>在来源栏中选择双栏都有的文件</tip>
			<icon1>#syncpane1</icon1>
			<function type="normal">
				<instruction>Select DESTTOSOURCE=in DESELECTNOMATCH</instruction>
			</function>
		</button>
		<button backcol="none" display="both" label_pos="right" textcol="none">
			<label>S&amp;elect Source-not-in-Destination</label>
			<tip>Select those file names in the source which do not exist in the destination</tip>
			<icon1>#flatview</icon1>
			<function type="normal">
				<instruction>Select DESTTOSOURCE=notin DESELECTNOMATCH</instruction>
			</function>
		</button>
		<button backcol="none" display="both" label_pos="right" textcol="none">
			<label>Se&amp;lect Source Selection to Destination</label>
			<tip>Select files in the destination with the same names as the files currently selected in the source</tip>
			<icon1>#flickrsync2</icon1>
			<function type="normal">
				<instruction>Select SOURCETODEST DESELECTNOMATCH</instruction>
			</function>
		</button>
		<button backcol="none" display="both" label_pos="right" textcol="none">
			<label>目标 | 来源无而目标有</label>
			<tip>选择来源文件夹中无而目标文件夹中有的文件</tip>
			<icon1>#syncpane1</icon1>
			<function type="normal">
				<instruction>Select SOURCETODEST=notin DESELECTNOMATCH</instruction>
			</function>
		</button>
		<button backcol="none" display="both" label_pos="right" textcol="none">
			<label>&amp;Select Source All to Destination</label>
			<tip>Select files in the destination with the same names as files that exist in the source</tip>
			<icon1>#syncpane1</icon1>
			<function type="normal">
				<instruction>Select SOURCETODEST=in DESELECTNOMATCH</instruction>
			</function>
		</button>
		<button backcol="none" display="both" label_pos="right" textcol="none">
			<label>Sele&amp;ct Source All to Destination (ignore extensions)</label>
			<tip>Select files in the destination with the same name stems as files that exist in the source (extensions may differ)</tip>
			<icon1>#syncpane1</icon1>
			<function type="normal">
				<instruction>Select SOURCETODEST=in,noext DESELECTNOMATCH</instruction>
			</function>
