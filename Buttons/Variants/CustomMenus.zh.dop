			<button backcol="none" display="both" hotkey_label="yes" textcol="none">
				<label>选择空文件夹(&amp;K)</label>
				<tip>选择无任何子文件的空文件夹</tip>
				<hotkeys>
					<chord>
						<key disable="yes">space</key>
						<key>K</key>
					</chord>
				</hotkeys>
				<icon1>#filterfield</icon1>
				<function type="script">
					<instruction>@script JScript</instruction>
					<instruction>function OnClick(clickData)</instruction>
					<instruction>{</instruction>
					<instruction>	var cmd = DOpus.Create.command;</instruction>
					<instruction>	var dirs = clickData.func.sourcetab.selected_dirs;</instruction>
					<instruction>	if(dirs.count == 0) //如果未选择文件夹</instruction>
					<instruction>		dirs = clickData.func.sourcetab.dirs;//以当前目录下所有文件夹作为基数</instruction>
					<instruction>	cmd.ClearFiles();//清除已选择的文件</instruction>
					<instruction>	</instruction>
					<instruction>	for (var eSel = new Enumerator(dirs); !eSel.atEnd(); eSel.moveNext())</instruction>
					<instruction>	{</instruction>
					<instruction>		var dir = eSel.item();</instruction>
					<instruction>		if (!dir.is_junction &amp;&amp; !dir.is_symlink) {</instruction>
					<instruction>			var dirEnum = DOpus.FSUtil.ReadDir(dir.RealPath);</instruction>
					<instruction>			//if (dirEnum.complete)</instruction>
					<instruction>			if (dirEnum.error==18){//无权限访问时error=5，无内容时error=18</instruction>
					<instruction>				//DOpus.Output(dirEnum.error);</instruction>
					<instruction>				//DOpus.Output(dir);</instruction>
					<instruction>				cmd.AddFile(dir);</instruction>
					<instruction>			}</instruction>
					<instruction>		}</instruction>
					<instruction>	}</instruction>
					<instruction>	cmd.RunCommand(&quot;Select FROMSCRIPT DESELECTNOMATCH&quot;);</instruction>
					<instruction>}</instruction>
				</function>
			</button>
			<button backcol="none" display="both" textcol="none">
