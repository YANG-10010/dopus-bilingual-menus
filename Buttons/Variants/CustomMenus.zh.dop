<?xml version="1.0" encoding="UTF-8"?>
<toolbar>
	<image_settings fill="none" fit="0x408" image="" inheritable="yes" opacity="100" use_custom="no" />
	<buttons backcol="none" display="label" textcol="none" type="menu">
<button backcol="none" display="both" label_pos="right" textcol="none" type="menu">
			<label>界面(&amp;U)</label>
			<icon1>#newmenu</icon1>
			<button backcol="none" display="both" label_pos="right" textcol="none" type="three_button">
				<label>背景[左键绿底/右键灰底]</label>
				<icon1>#default:godesktop</icon1>
				<button backcol="none" display="both" label_pos="right" textcol="none">
					<label>绿底</label>
					<tip>绿底</tip>
					<icon1>#default:godesktop</icon1>
					<function type="normal">
						<instruction>Set GRIDLINESH &quot;reset,toggle,fill,color=#D1DBD0,opacity=255&quot;</instruction>
						<instruction>Set BACKGROUNDIMAGE=filedisplay: BACKGROUNDIMAGEOPTS=fillcolor:#E7F8E9</instruction>
						<instruction>Set BACKGROUNDIMAGE=tree: BACKGROUNDIMAGEOPTS=fillcolor:#E7F8E9</instruction>
						<instruction>// Set BACKGROUNDIMAGE=tree: BACKGROUNDIMAGEOPTS=fillcolor:#CCEDC7</instruction>
					</function>
				</button>
				<button backcol="none" display="both" label_pos="right" textcol="none">
					<label>灰底</label>
					<tip>灰底</tip>
					<icon1>#default:godesktop</icon1>
					<function type="normal">
						<instruction>Set GRIDLINESH &quot;reset,toggle,fill,color=#E1E1E1,opacity=255&quot;</instruction>
						<instruction>Set BACKGROUNDIMAGE=filedisplay: BACKGROUNDIMAGEOPTS=fillcolor:#F5F5F5</instruction>
						<instruction>Set BACKGROUNDIMAGE=tree: BACKGROUNDIMAGEOPTS=fillcolor:#E7F8E9</instruction>
					</function>
				</button>
			</button>
			<button backcol="none" display="both" label_pos="right" textcol="none">
				<label>启用大小相对图形</label>
				<icon1>#default:getsizes</icon1>
				<function type="normal">
					<instruction>Set RELATIVESIZEGRAPHS=toggle</instruction>
				</function>
			</button>
			<button backcol="none" display="both" label_pos="right" textcol="none">
				<label>启用日期相对图形</label>
				<icon1>#default:recentlist</icon1>
				<function type="normal">
					<instruction>Set RELATIVEDATEGRAPHS=toggle</instruction>
				</function>
			</button>
			<button backcol="none" display="both" label_pos="right" textcol="none">
				<label>显示友好日期</label>
				<icon1>#default:setdate</icon1>
				<function type="normal">
					<instruction>Set FRIENDLYDATES=toggle,normal</instruction>
				</function>
			</button>
			<button backcol="none" display="both" label_pos="right" textcol="none">
				<label>启用标记分配</label>
				<icon1>#default:setcolor</icon1>
				<function type="normal">
					<instruction>Set ENABLELABELFILTER toggle,三天内修改</instruction>
					<instruction>Set ENABLELABELFILTER toggle,空文件夹</instruction>
					<instruction>Set ENABLELABELFILTER toggle,程序文件</instruction>
					<instruction>Set ENABLELABELFILTER toggle,图片</instruction>
					<instruction>Set ENABLELABELFILTER toggle,音视频</instruction>
					<instruction>Set ENABLELABELFILTER toggle,压缩文件</instruction>
					<instruction>Set ENABLELABELFILTER toggle,文档</instruction>
				</function>
			</button>
			<button backcol="none" display="both" label_pos="right" separate="yes" textcol="none">
				<label>&amp;Full-Row Selection</label>
				<icon1>#default:fullrowselection</icon1>
				<function type="normal">
					<instruction>Set FULLROWSELECT=Toggle,NameCol</instruction>
				</function>
			</button>
			<button backcol="none" display="both" label_pos="right" textcol="none">
				<label>启用网格换行</label>
				<tip>仅改变当前显示窗口，不修改首选项配置</tip>
				<icon1>#default:gridlines</icon1>
				<function type="normal">
					<instruction>Set GRIDLINESH=toggle</instruction>
				</function>
			</button>
			<button backcol="none" display="both" label_pos="right" textcol="none">
				<label>启用纵列网格线</label>
				<tip>仅对详情和增强模式有效\n仅改变当前显示窗口，不修改首选项配置</tip>
				<icon1>#default:sortby</icon1>
				<function type="normal">
					<instruction>// GRIDLINESH 样式参数 solid实线, alternate抖动线, dot点状线, dash虚线, dashdot虚线+点, dashdotdot虚线+两点</instruction>
					<instruction>// Set GRIDLINESV &quot;toggle,solid,color=#808080,opacity=80&quot;</instruction>
					<instruction>Set GRIDLINESV &quot;toggle,dash,color=#EE6666,opacity=255&quot;</instruction>
				</function>
			</button>
			<button backcol="none" display="both" label_pos="right" textcol="none">
				<label>启用[创建+修改]距今</label>
				<tip>仅改变当前显示窗口，不修改首选项配置</tip>
				<icon1>#default:flatview</icon1>
				<function type="normal">
					<instruction>SET COLUMNSTOGGLE=&quot;scp:FileAge/Modify(4)&quot;</instruction>
					<instruction>SET COLUMNSTOGGLE=&quot;scp:FileAge/Create(4)&quot;</instruction>
				</function>
			</button>
			<button backcol="none" display="both" label_pos="right" separate="yes" textcol="none">
				<label>启用[名称长度]排序</label>
				<tip>仅改变当前显示窗口，不修改首选项配置</tip>
				<icon1>#default:flatview</icon1>
				<function type="normal">
					<instruction>Set COLUMNSTOGGLE=eval:namelength(!,80)</instruction>
					<instruction>Set SORTBY=eval:namelength SORTREVERSE=togglesmart</instruction>
				</function>
			</button>
			<button backcol="none" display="both" label_pos="right" textcol="none" type="three_button">
				<label>切换[平面显示+按类型分组]</label>
				<icon1>#default:folderformatslist</icon1>
				<button backcol="none" display="both" label_pos="right" textcol="none">
					<label>切换[平面显示+按类型分组]</label>
					<tip>切换开关</tip>
					<icon1>#default:folderformatslist</icon1>
					<function type="normal">
						<instruction>@nodeselect </instruction>
						<instruction>@if:Set FLATVIEW=off</instruction>
						<instruction>Set FLATVIEW=mixed</instruction>
						<instruction>Set GROUPBY=&quot;extdir&quot; GROUPFOLDERSATTOP=on</instruction>
						<instruction>Go GROUPCOLLAPSE=*</instruction>
						<instruction>@if:else</instruction>
						<instruction>Set FLATVIEW=off</instruction>
						<instruction>Set GROUPBY=off</instruction>
						<instruction>Set COLUMNSADD=Index(0,a)</instruction>
						<instruction>SET COLUMNSFREEZE=1</instruction>
						<instruction>Set COLUMNSREMOVE=&quot;pathrel&quot;</instruction>
					</function>
				</button>
				<button backcol="none" display="both" label_pos="right" textcol="none">
					<label>折叠/展开所有组</label>
					<icon1>#default:groupby</icon1>
					<function type="normal">
						<instruction>@if:enabled Go GROUPCOLLAPSE=*</instruction>
						<instruction>GO GROUPCOLLAPSE=*</instruction>
						<instruction>@if:else</instruction>
						<instruction>GO GROUPEXPAND=*</instruction>
					</function>
				</button>
			</button>
			<button backcol="none" display="both" label_pos="right" textcol="none" type="three_button">
				<label>切换[平面显示+按注释分组]</label>
				<icon1>#default:folderformatslist</icon1>
				<button backcol="none" display="both" label_pos="right" textcol="none">
					<label>切换[平面显示+按注释分组]</label>
					<tip>切换开关</tip>
					<icon1>#default:folderformatslist</icon1>
					<function type="normal">
						<instruction>@nodeselect </instruction>
						<instruction>@if:Set FLATVIEW=off</instruction>
						<instruction>Set FLATVIEW=mixed</instruction>
						<instruction>Set GROUPBY=&quot;comments&quot; GROUPFOLDERSATTOP=on</instruction>
						<instruction>Set GROUPCOMBINE=never</instruction>
						<instruction>Go GROUPCOLLAPSE=*</instruction>
						<instruction>@if:else</instruction>
						<instruction>Set FLATVIEW=off</instruction>
						<instruction>Set GROUPBY=off</instruction>
						<instruction>Set COLUMNSADD=Index(0,a)</instruction>
						<instruction>SET COLUMNSFREEZE=1</instruction>
						<instruction>Set COLUMNSREMOVE=&quot;pathrel&quot;</instruction>
					</function>
				</button>
				<button backcol="none" display="both" label_pos="right" textcol="none">
					<label>折叠/展开所有组</label>
					<icon1>#default:groupby</icon1>
					<function type="normal">
						<instruction>@if:enabled Go GROUPCOLLAPSE=*</instruction>
						<instruction>GO GROUPCOLLAPSE=*</instruction>
						<instruction>@if:else</instruction>
						<instruction>GO GROUPEXPAND=*</instruction>
					</function>
				</button>
			</button>
		</button>
<button backcol="none" display="both" label_pos="right" textcol="none" type="menu">
			<label>标签(&amp;B)</label>
			<hotkeys>
				<chord>
					<key disable="yes">ctrl+shift+M</key>
					<key>T</key>
				</chord>
			</hotkeys>
			<icon1>#foldertabs</icon1>
			<button backcol="none" display="both" label_pos="right" textcol="none" type="menu">
				<label>标签位置</label>
				<icon1>#foldertabgrouplist</icon1>
				<button backcol="none" display="both" label_pos="right" textcol="none">
					<label>标签位置</label>
					<tip>重置为选项中设置的标签位置</tip>
					<icon1>#foldertabgrouplist</icon1>
					<function type="normal">
						<instruction>Set TABPOSITION=reset</instruction>
					</function>
				</button>
				<button backcol="none" display="label" textcol="none">
					<label>纵列相近</label>
					<icon1>#newcommand</icon1>
					<function type="normal">
						<instruction> Set TABPOSITION=left,together</instruction>
					</function>
				</button>
				<button backcol="none" display="label" textcol="none">
					<label>横行相近</label>
					<icon1>#newcommand</icon1>
					<function type="normal">
						<instruction> Set TABPOSITION=above,together</instruction>
					</function>
				</button>
				<button backcol="none" display="label" textcol="none">
					<label>居上</label>
					<icon1>#newcommand</icon1>
					<function type="normal">
						<instruction>Set TABPOSITION=above</instruction>
					</function>
				</button>
				<button backcol="none" display="label" textcol="none">
					<label>居下</label>
					<icon1>#newcommand</icon1>
					<function type="normal">
						<instruction>Set TABPOSITION=below</instruction>
					</function>
				</button>
				<button backcol="none" display="label" textcol="none">
					<label>居左</label>
					<icon1>#newcommand</icon1>
					<function type="normal">
						<instruction>Set TABPOSITION=left </instruction>
					</function>
				</button>
				<button backcol="none" display="label" textcol="none">
					<label>居右</label>
					<icon1>#newcommand</icon1>
					<function type="normal">
						<instruction>Set TABPOSITION=right</instruction>
					</function>
				</button>
				<button backcol="none" display="label" textcol="none">
					<label>相近</label>
					<tip>双栏时，两边的标签栏靠近在一起</tip>
					<icon1>#newcommand</icon1>
					<function type="normal">
						<instruction>Set TABPOSITION=together</instruction>
					</function>
				</button>
				<button backcol="none" display="label" textcol="none">
					<label>相远</label>
					<tip>双栏时，两边的标签栏远离到两端</tip>
					<icon1>#newcommand</icon1>
					<function type="normal">
						<instruction>Set TABPOSITION=apart</instruction>
					</function>
				</button>
				<button backcol="none" display="both" label_pos="right" textcol="none">
					<label>设置标签宽度为120</label>
					<tip>仅当标签栏位于左/右方才有效，位于上/下方无效</tip>
					<icon1>#foldertabs</icon1>
					<function type="normal">
						<instruction>Set TABWIDTH=120</instruction>
					</function>
				</button>
				<button backcol="none" display="both" label_pos="right" textcol="none">
					<label>首选项标签设置</label>
					<icon1>#empty</icon1>
					<function type="normal">
						<instruction>//Prefs PAGE=foldertabs</instruction>
						<instruction>Prefs PAGE=&quot;foldertabbars&quot;</instruction>
					</function>
				</button>
			</button>
			<button backcol="none" display="both" hotkey_label="yes" label_pos="right" textcol="none">
				<label>在新标签中打开路径</label>
				<tip>若未选择，则在新标签中打开当前路径\n若选中软链接，则在新标签中打开其目标\n若有选中文件夹，则在新标签中打开之\n若只选中文件且含有快捷方式(.lnk)，则打开其目标\n未选中.lnk，则在新标签中打开当前路径</tip>
				<hotkeys>
					<key disable="yes">ctrl+T</key>
				</hotkeys>
				<icon1>#newtab</icon1>
				<function type="script">
					<instruction>@script JScript</instruction>
					<instruction>//为选定文件夹新建标签</instruction>
					<instruction>//Go NEWTAB=nofocus,findexisting FROMSEL</instruction>
					<instruction />
					<instruction>function OnClick(clickData)</instruction>
					<instruction>{</instruction>
					<instruction>	//DOpus.ClearOutput();</instruction>
					<instruction>	var cmd = clickData.func.command;</instruction>
					<instruction>	cmd.deselect = false;</instruction>
					<instruction>	var Mycmd = &quot;Go CURRENT NEWTAB&quot;;</instruction>
					<instruction>	var stab = clickData.func.sourcetab;</instruction>
					<instruction>	//if (stab.path.drive == 0 &amp;&amp; stab.selected.count &gt; 0)</instruction>
					<instruction>	//Mycmd = &quot;Go OPENCONTAINER NEWTAB=findexisting&quot;;</instruction>
					<instruction>	var sels = stab.selected;</instruction>
					<instruction>	if(sels.count &gt; 0){</instruction>
					<instruction>		if(sels(0).is_junction || sels(0).is_symlink || sels(0).ext == &quot;.lnk&quot; || //第一个选中项若是指向性的，则打开其目标位置</instruction>
					<instruction>			(!sels(0).is_dir &amp;&amp; DOpus.FSUtil.PathType(stab.path) == &quot;coll&quot;) ){ //在文件收集中，若选中第一项是文件则打开其父目录</instruction>
					<instruction>			Mycmd = &quot;Go opencontainer=target NEWTAB=findexisting,tofront&quot;;</instruction>
					<instruction>		} else {</instruction>
					<instruction>			if (stab.selected_dirs.count &gt; 0)</instruction>
					<instruction>				Mycmd = &quot;Go NEWTAB=nofocus,findexisting FROMSEL&quot;;//若选中了文件夹，则在新标签中打开文件夹</instruction>
					<instruction>			else //if (stab.selected_files.count &gt; 0)</instruction>
					<instruction>			{//未选中文件夹，只选中文件时，遍历判断是否包含.lnk快捷方式</instruction>
					<instruction>				for (var eSel = new Enumerator(stab.selected); !eSel.atEnd(); eSel.moveNext())</instruction>
					<instruction>				{</instruction>
					<instruction>					if (eSel.item().ext == &quot;.lnk&quot;)</instruction>
					<instruction>					{</instruction>
					<instruction>						Mycmd = &quot;Go opencontainer=target NEWTAB=findexisting,tofront&quot;;//打开快捷方式的目标位置</instruction>
					<instruction>						break;</instruction>
					<instruction>					}</instruction>
					<instruction>				}</instruction>
					<instruction>			}</instruction>
					<instruction>		}</instruction>
					<instruction>	}</instruction>
					<instruction>	cmd.RunCommand(Mycmd);</instruction>
					<instruction>}</instruction>
				</function>
			</button>
			<button backcol="none" display="both" hotkey="alt+T" hotkey_label="yes" textcol="none">
				<label>打开选定文件夹到目标栏</label>
				<tip>若未选择，则在目标栏中打开当前路径\n若有选中文件夹，则在目标兰中打开之\n若只选中文件且选中项有快捷方式(.lnk)，则打开其指向的目标\n</tip>
				<icon1>#getsizes</icon1>
				<function type="script">
					<instruction />
					<instruction>@script JScript</instruction>
					<instruction>/*function OnClick(clickData)</instruction>
					<instruction>{</instruction>
					<instruction>	var cmd = clickData.func.command;</instruction>
					<instruction>	cmd.deselect = false; // Prevent automatic deselection</instruction>
					<instruction>	if(clickData.func.sourcetab.selected_dirs.count == 0)</instruction>
					<instruction>	cmd.RunCommand(&quot;go current newtab=deflister,findexisting openindual&quot;);</instruction>
					<instruction>	else</instruction>
					<instruction>	cmd.RunCommand(&quot;go fromsel newtab=deflister,findexisting openindual&quot;);</instruction>
					<instruction>}</instruction>
					<instruction>*/</instruction>
					<instruction>function OnClick(clickData)</instruction>
					<instruction>{</instruction>
					<instruction>	//DOpus.ClearOutput();</instruction>
					<instruction>	var cmd = clickData.func.command;</instruction>
					<instruction>	cmd.deselect = false; // Prevent automatic deselection</instruction>
					<instruction>	var Mycmd = &quot;Go CURRENT NEWTAB=deflister,findexisting openindual&quot;;</instruction>
					<instruction>	var stab = clickData.func.sourcetab;</instruction>
					<instruction>	//if (stab.path.drive == 0 &amp;&amp; stab.selected.count &gt; 0)</instruction>
					<instruction>	//Mycmd = &quot;Go OPENCONTAINER NEWTAB=deflister,findexisting openindual&quot;;</instruction>
					<instruction>		if (stab.selected_dirs.count &gt; 0)</instruction>
					<instruction>		Mycmd = &quot;go fromsel newtab=deflister,findexisting openindual&quot;;</instruction>
					<instruction>		else if (stab.selected_files.count &gt; 0)</instruction>
					<instruction>		{</instruction>
					<instruction>			for (var eSel = new Enumerator(stab.selected); !eSel.atEnd(); eSel.moveNext())</instruction>
					<instruction>			{</instruction>
					<instruction>				if (eSel.item().ext == &quot;.lnk&quot;)</instruction>
					<instruction>				{</instruction>
					<instruction>					DOpus.Output(eSel.item().ext);</instruction>
					<instruction>					Mycmd = &quot;go opencontainer=target newtab=deflister,findexisting,tofront openindual&quot;;</instruction>
					<instruction>					break;</instruction>
					<instruction>				}</instruction>
					<instruction>			}</instruction>
					<instruction>		}</instruction>
					<instruction>	cmd.RunCommand(Mycmd);</instruction>
					<instruction>}</instruction>
				</function>
			</button>
			<button backcol="none" display="both" hotkey="alt+Y" hotkey_label="yes" label_pos="right" textcol="none">
				<label>移动标签到目标栏(&amp;Y)</label>
				<tip>仅有一个标签时，复制当前标签到目标栏；否则移动标签到目标栏</tip>
				<icon1>#syncpane1</icon1>
				<function type="script">
					<instruction>@script JScript</instruction>
					<instruction>function OnClick(clickData)</instruction>
					<instruction>{</instruction>
					<instruction>	var cmd = clickData.func.command;</instruction>
					<instruction>	cmd.deselect = false;</instruction>
					<instruction>	var vlis = clickData.func.sourcetab.lister;</instruction>
					<instruction>	//if(vlis.dual != 0 || clickData.func.tabs &gt; 1){</instruction>
					<instruction>	if(vlis.tabs.count == 1)</instruction>
					<instruction>		cmd.RunCommand(&quot;Go CURRENT NEWTAB=deflister,findexisting openindual&quot;);</instruction>
					<instruction>	else</instruction>
					<instruction>		cmd.RunCommand(&quot;Go TABMOVE=active&quot;);</instruction>
					<instruction>}</instruction>
				</function>
			</button>
			<button backcol="none" display="both" hotkey="186,4" hotkey_label="yes" label_pos="right" textcol="none">
				<label>从当前标签拆分为双栏(&amp;F)</label>
				<tip>仅当单栏时，将当前标签及其后标签全部拆分到双栏另一边</tip>
				<icon1>#syncpane1</icon1>
				<function type="normal">
					<instruction>Go TABMOVE=split</instruction>
				</function>
			</button>
			<button backcol="none" display="both" hotkey="ctrl+shift+Y" hotkey_label="yes" label_pos="right" textcol="none">
				<label>双栏时合并所有标签到单栏</label>
				<icon1>#syncpane1</icon1>
				<function type="script">
					<instruction>//@hideif:!Set DUAL=toggle</instruction>
					<instruction>@script JScript</instruction>
					<instruction>function OnClick(clickData)</instruction>
					<instruction>{</instruction>
					<instruction>	var cmd = clickData.func.command;</instruction>
					<instruction>	cmd.deselect = false;</instruction>
					<instruction>	var sTab = clickData.func.sourcetab</instruction>
					<instruction>	var lis = sTab.lister;</instruction>
					<instruction>	if(lis.dual==0) return;</instruction>
					<instruction />
					<instruction>	var sumleft = lis.tabsleft.count, sumright = lis.tabsright.count;</instruction>
					<instruction>	var l_r = &quot;right&quot;, sum = sumright, selectN = &quot;first&quot;, side = &quot; OPENINRIGHT&quot;, tabN = &quot;&quot;;</instruction>
					<instruction>	if(sumleft &lt; sumright){</instruction>
					<instruction>		l_r = &quot;left&quot;; sum = sumleft; selectN = &quot;last&quot;; side = &quot; OPENINLEFT&quot;; tabN = &quot;=0&quot;;</instruction>
					<instruction>	}</instruction>
					<instruction />
					<instruction>	//if(sTab.right){</instruction>
					<instruction>	for(var i=0; i&lt;sum; i++)</instruction>
					<instruction>		{</instruction>
					<instruction>			cmd.RunCommand(&apos;Set FOCUS=&apos;+l_r);</instruction>
					<instruction>			cmd.RunCommand(&apos;Go TABSELECT=&apos;+selectN+side);</instruction>
					<instruction>			lis.Update()</instruction>
					<instruction>			//log(lis.activetab.path)</instruction>
					<instruction>			cmd.SetSourceTab(lis.activetab);</instruction>
					<instruction>			cmd.RunCommand(&apos;Go TABMOVE&apos;+tabN);</instruction>
					<instruction>			lis.Update()</instruction>
					<instruction>			if(lis.dual==0) break;</instruction>
					<instruction>		}</instruction>
					<instruction>	</instruction>
					<instruction>	/*</instruction>
					<instruction>	var sTab = clickData.func.sourcetab</instruction>
					<instruction>	var dTab = clickData.func.desttab</instruction>
					<instruction>	var LTab, RTab</instruction>
					<instruction>	if(sTab.right){</instruction>
					<instruction>		LTab = dTab</instruction>
					<instruction>		RTab = sTab</instruction>
					<instruction>	} else {</instruction>
					<instruction>		LTab = sTab</instruction>
					<instruction>		RTab = dTab</instruction>
					<instruction>	}</instruction>
					<instruction>	*/</instruction>
					<instruction>}</instruction>
					<instruction />
					<instruction>function log(str){DOpus.Output(str,false,true);}</instruction>
				</function>
			</button>
			<button backcol="none" display="both" hotkey="191,2" hotkey_label="yes" label_pos="right" textcol="none">
				<label>打开选定项的上级目录到目标栏</label>
