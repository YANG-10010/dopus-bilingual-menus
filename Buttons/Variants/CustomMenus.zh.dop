			<button backcol="none" display="both" textcol="none" type="menu">
				<label>同扩展名(&amp;E)</label>
				<icon1>#newmenu</icon1>
				<button backcol="none" display="both" hotkey="187,4" textcol="none">
					<label>选择相同扩展名(焦点)\tAlt+=</label>
					<tip>选择与焦点处文件具有相同扩展名的所有文件</tip>
					<icon1>#duplicate</icon1>
					<function type="script">
						<instruction>@script JScript</instruction>
						<instruction>function OnClick(clickData)</instruction>
						<instruction>{</instruction>
						<instruction>	var cmd = clickData.func.command;</instruction>
						<instruction>	cmd.deselect = false;</instruction>
						<instruction>	var focusitem = clickData.func.sourcetab.GetFocusItem();</instruction>
						<instruction>	if(focusitem.is_dir)</instruction>
						<instruction>		cmd.RunCommand(&quot;Select ALLDIRS&quot;);</instruction>
						<instruction>	else{</instruction>
						<instruction>		var selext=focusitem.ext;</instruction>
						<instruction>		if(selext)</instruction>
						<instruction>		cmd.RunCommand(&quot;Select *&quot;+selext);</instruction>
						<instruction>	}</instruction>
						<instruction>}</instruction>
					</function>
				</button>
				<button backcol="none" display="both" label_pos="right" textcol="none">
					<label>选择全部相同扩展名</label>
					<tip>选择与选定的所有文件具有相同扩展名的文件</tip>
					<icon1>#advancedselect</icon1>
					<function type="normal">
						<instruction>Select SIMILAR=trueext</instruction>
					</function>
				</button>
				<button backcol="none" display="both" label_pos="right" textcol="none">
					<label>选择相同基本名(&amp;J)\t空格, J</label>
					<tip>选择具有相同基本名的文件，忽略扩展名</tip>
					<hotkeys>
						<chord>
							<key disable="yes">space</key>
							<key>J</key>
						</chord>
					</hotkeys>
					<icon1>#advancedselect</icon1>
					<function type="normal">
						<instruction>Select SIMILARBASE</instruction>
					</function>
				</button>
				<button backcol="none" display="both" hotkey="189,4" textcol="none">
					<label>不选相同扩展名\tAlt+-</label>
					<tip>取消选择与焦点处文件扩展名相同的所有文件</tip>
					<icon1>#selectnone</icon1>
					<function type="script">
						<instruction>@script JScript</instruction>
						<instruction>function OnClick(clickData) {</instruction>
						<instruction>	var cmd = clickData.func.command;</instruction>
						<instruction>	cmd.deselect = false;</instruction>
						<instruction>	</instruction>
						<instruction>	var selext = clickData.func.sourcetab.GetFocusItem().ext;</instruction>
						<instruction>	if(selext)</instruction>
						<instruction>		cmd.RunCommand(&quot;Select *&quot;+selext+&quot; DESELECT&quot;);</instruction>
						<instruction>}</instruction>
					</function>
				</button>
			</button>
			<button backcol="none" display="both" textcol="none" type="menu">
				<label>随机选择</label>
				<icon1>#selectwild</icon1>
				<button backcol="none" display="both" label_pos="right" textcol="none">
					<label>随机选择一个文件</label>
					<tip>有仪式感的选择文件</tip>
					<icon1>#swapsourcedest</icon1>
					<function type="script">
						<instruction>@script JScript</instruction>
						<instruction>function OnClick(clickData)</instruction>
						<instruction>{</instruction>
						<instruction>	var cmd = clickData.func.command;</instruction>
						<instruction>	var files=clickData.func.sourcetab.files;</instruction>
						<instruction>	var dirs=clickData.func.sourcetab.dirs;</instruction>
						<instruction>	var count=files.count+dirs.count;</instruction>
						<instruction>	var rndcound=Math.floor(Math.random()*count+1)-1</instruction>
						<instruction>	cmd.RunCommand(&apos;Select RANGE &apos;+rndcound);</instruction>
						<instruction>}</instruction>
					</function>
				</button>
				<button backcol="none" display="both" textcol="none">
					<label>随机选择并播放1个视频文件</label>
					<tip>Select and Play 1 random movie file</tip>
					<icon1>#play</icon1>
					<function type="normal">
						<instruction>SelectEx RANDOM ITEMCOUNT=1 NAME=&quot;\.(avi|mov|mpg|divx|mp4)$&quot; FILES MAKEVISIBLE DESELECTNOMATCH ACTION=&quot;dblclk&quot;</instruction>
					</function>
				</button>
				<button backcol="none" display="both" textcol="none">
					<label>随机选择文件夹缩略图</label>
					<tip>Select random folder thumbnail</tip>
					<icon1>#thumbnails</icon1>
					<function type="script">
						<instruction>@script jscript</instruction>
						<instruction>function OnClick(data){</instruction>
						<instruction>	var cmd = data.func.command, tab = data.func.sourcetab;</instruction>
						<instruction>	for (var iEnum = new Enumerator(tab.selected_dirs); !iEnum.atEnd(); iEnum.moveNext()){</instruction>
						<instruction>		var folder = iEnum.item()</instruction>
						<instruction>		cmd.RunCommand(&apos;SelectEx XLOG=all RANDOM PATH=&quot;&apos;+folder.realpath+&apos;&quot; RECURSE FILES SETVAR=&quot;SelexResult&quot; NAME=&quot;\.jpg$&quot; ECHO&apos;);</instruction>
						<instruction>		var imagePath = tab.Vars.Get(&quot;SelexResult&quot;);</instruction>
						<instruction>		if (imagePath==&quot;&quot;) continue;</instruction>
						<instruction>		cmd.RunCommand(&apos;Image CONVERT=jpg AS=folder.jpg HEIGHT=512 WIDTH=512 &apos;+</instruction>
						<instruction>			&apos;PRESERVEASPECTRATIO REPLACE=always FROM=&quot;&apos;+imagePath+&apos;&quot; TO=&quot;&apos;+folder.realpath+&apos;&quot;&apos;);</instruction>
						<instruction>		cmd.RunCommand(&apos;SetAttr ATTR=hs FILE=&quot;&apos;+folder.realpath+&apos;\\folder.jpg&quot;&apos;);</instruction>
						<instruction>		//DOpus.Output(&quot;EnvResult: &quot; + new ActiveXObject(&quot;WScript.Shell&quot;).Environment(&quot;Process&quot;)(&quot;SRResult&quot;));</instruction>
						<instruction>	}</instruction>
						<instruction>}</instruction>
					</function>
				</button>
				<button backcol="none" display="both" textcol="none">
					<label>随机选择 8GB mp3专辑(文件夹)</label>
					<tip>Select 8GB of random mp3 albums (folders)</tip>
					<icon1>#play2</icon1>
					<function type="normal">
						<instruction>SelectEx RANDOM MAXSIZETOTAL=8gb ITEMCOUNT=999999 FOLDERS DESELECTNOMATCH MAKEVISIBLE</instruction>
					</function>
				</button>
				<button backcol="none" display="both" textcol="none">
					<label>随机将10个摇滚乐曲放入摇滚文件收集中(慎用)</label>
					<tip>Put 10 random &quot;Rock&quot; tunes into &quot;Rock&quot; file collection</tip>
					<icon1>#Windows_icos_plus:24.Play Music</icon1>
					<function type="script">
						<instruction>@script jscript</instruction>
						<instruction />
						<instruction>var pickGenre = &quot;Rock&quot;;</instruction>
						<instruction>var doColName = &quot;Rock&quot;;</instruction>
						<instruction />
						<instruction>function OnClick(data){</instruction>
						<instruction>	if (!DOpus.Dlg.Request(&quot;This can take some time, continue?&quot;,&quot;Ok|Cancel&quot;)) return;</instruction>
						<instruction>	</instruction>
						<instruction>	var cmd = data.func.command;</instruction>
						<instruction>	var jsFilter = &quot;&quot;+</instruction>
						<instruction>    &quot;if (item.metadata == &apos;audio&apos;){ &quot;+</instruction>
						<instruction>        &quot;var genre = new String(item.metadata.audio[&apos;mp3genre&apos;]);&quot;+</instruction>
						<instruction>        &quot;if (genre.toLowerCase().indexOf(&apos;&quot;+pickGenre+&quot;&apos;.toLowerCase())!=-1)&quot;+</instruction>
						<instruction>			&quot;return false; /*do not filter*/&quot;+</instruction>
						<instruction>    &quot;}&quot;;</instruction>
						<instruction />
						<instruction>	cmd.RunCommand(&apos;SelectEx RANDOM &apos;+</instruction>
						<instruction>					&apos;ITEMCOUNT=10 &apos;+</instruction>
						<instruction>					&apos;PATH=&quot;&apos;+data.func.sourcetab.path+&apos;&quot; &apos;+</instruction>
						<instruction>					&apos;JSFILTER=&quot;&apos;+jsFilter+&apos;&quot; &apos;+</instruction>
						<instruction>					&apos;NAME=&quot;\\.mp3$&quot; &apos;+</instruction>
						<instruction>					&apos;RECURSE &apos;+</instruction>
						<instruction>					&apos;XLOG=all &apos;+</instruction>
						<instruction>					&apos;SETVAR=SelexResult &apos;+</instruction>
						<instruction>					&apos;COPYTOCOLL=&quot;&apos;+doColName+&apos;&quot; &apos;+</instruction>
						<instruction>					&apos;COMMANDS=Go NEWTAB=findexisting &quot;coll://&apos;+doColName+&apos;&quot;&apos;);</instruction>
						<instruction />
						<instruction>	if (data.func.sourcetab.Vars.Get(&quot;SelexResult&quot;)==&quot;&quot;)</instruction>
						<instruction>		DOpus.Dlg.Request(&quot;Sorry, no tunes found.&quot;);</instruction>
						<instruction>}</instruction>
						<instruction> </instruction>
					</function>
				</button>
				<button backcol="none" display="both" textcol="none">
					<label>随机选择并幻灯片播放20个图片</label>
					<tip>Select and Slideshow 20 random image files</tip>
					<icon1>#DOpus9:thumbnails</icon1>
					<function type="normal">
						<instruction>SelectEx RANDOM FILES ITEMCOUNT=20 NAME=&quot;\.(jpg|png|gif|bmp)&quot; DESELECTNOMATCH COMMANDS=Show SLIDESHOW</instruction>
					</function>
				</button>
				<button backcol="none" display="both" textcol="none">
					<label>随机选择100个mp3文件</label>
					<tip>Select 100 random mp3 files</tip>
					<icon1>#togglesounds</icon1>
					<function type="normal">
						<instruction>SelectEx RANDOM ITEMCOUNT=100 NAME=&quot;\.mp3$&quot; FILES MAKEVISIBLE DESELECTNOMATCH</instruction>
					</function>
				</button>
				<button backcol="none" display="both" textcol="none">
					<label>随机选择50%项</label>
					<tip>Select 50% random items</tip>
					<icon1>#favoritesadd</icon1>
					<function type="normal">
						<instruction>SelectEx RANDOM ITEMCOUNTPERC=50 MAKEVISIBLE DESELECTNOMATCH</instruction>
					</function>
				</button>
			</button>
			<button backcol="none" display="both" textcol="none" type="menu_button">
				<label>复选框</label>
				<tip>Checkboxes</tip>
				<icon1>#checkboxmode</icon1>
				<function type="normal">
					<instruction>@keydown:none</instruction>
					<instruction>Set CHECKBOXMODE=Toggle</instruction>
				</function>
				<button backcol="none" display="both" label_pos="right" textcol="none">
					<label>&amp;Selection to Checkboxes</label>
					<tip>Set the checkbox state to match the current selection</tip>
					<icon1>#checkboxmode</icon1>
					<function type="normal">
						<instruction>Select TOCHECKS</instruction>
					</function>
				</button>
				<button backcol="none" display="both" label_pos="right" textcol="none">
					<label>&amp;Checkboxes to Selection</label>
					<tip>Set the selection to match the checkbox state</tip>
					<icon1>#checkboxmode</icon1>
					<function type="normal">
						<instruction>Select FROMCHECKS </instruction>
					</function>
				</button>
			</button>
			<button backcol="none" display="both" separate="yes" textcol="none" type="menu">
				<label>更多...</label>
				<tip>More..</tip>
				<icon1>#advancedselect</icon1>
				<button backcol="none" display="both" textcol="none">
					<label>选择前x个文件...</label>
					<tip>Select the first x files..</tip>
					<icon1>#selectinvert</icon1>
					<function type="normal">
						<instruction>SelectEx LINEAR FILES ITEMCOUNT={dlgstring|输入要选择的数量:|100} DESELECTNOMATCH MAKEVISIBLE</instruction>
					</function>
				</button>
				<button backcol="none" display="both" textcol="none">
					<label>选择前20个文件夹</label>
					<tip>Select the first 20 folders</tip>
					<icon1>#selectinvert</icon1>
					<function type="normal">
						<instruction>SelectEx LINEAR ITEMCOUNT=20 FOLDERS MAKEVISIBLE DESELECTNOMATCH</instruction>
					</function>
				</button>
				<button backcol="none" display="both" textcol="none">
					<label>选择前25%项</label>
					<tip>Select the first 25% percent</tip>
					<icon1>#selectinvert</icon1>
					<function type="normal">
						<instruction>SelectEx LINEAR ITEMCOUNTPERC=25 MAKEVISIBLE DESELECTNOMATCH</instruction>
					</function>
				</button>
			</button>
		</button>
	</buttons>
</toolbar>
