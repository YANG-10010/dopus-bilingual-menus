			</button>
			<button backcol="none" display="both" hotkey_label="yes" label_pos="right" separate="yes" textcol="none">
				<label>Sort Tabs</label>
				<tip>Sort Tabs</tip>
				<hotkeys>
					<chord>
						<key>tab</key>
						<key>S</key>
					</chord>
				</hotkeys>
				<icon1>#sortby</icon1>
				<function type="script">
					<instruction>@script JScript</instruction>
					<instruction>function OnClick(clickData)</instruction>
					<instruction>{</instruction>
					<instruction>	var cmd = clickData.func.command;</instruction>
					<instruction>	cmd.deselect = false; // Prevent automatic deselection</instruction>
					<instruction>	cmd.ClearFiles();</instruction>
					<instruction />
					<instruction>	sortTabs(cmd, clickData.func.sourcetab.lister.tabsleft);</instruction>
					<instruction>	sortTabs(cmd, clickData.func.sourcetab.lister.tabsright);</instruction>
					<instruction>}</instruction>
					<instruction />
					<instruction>function sortTabs(cmd, tabList)</instruction>
					<instruction>{</instruction>
					<instruction>	var setLabels = DOpus.Create.StringSet();</instruction>
					<instruction>	var mapLabelToTabVec = DOpus.Create.Map();</instruction>
					<instruction />
					<instruction>	for (var eTabs = new Enumerator(tabList); !eTabs.atEnd(); eTabs.moveNext())</instruction>
					<instruction>	{</instruction>
					<instruction>		var tab = eTabs.item();</instruction>
					<instruction>		var label = tab.displayed_label.toLowerCase();</instruction>
					<instruction />
					<instruction>		setLabels.insert(label);</instruction>
					<instruction />
					<instruction>		if (!mapLabelToTabVec.exists(label))</instruction>
					<instruction>		{</instruction>
					<instruction>			mapLabelToTabVec(label) = DOpus.Create.Vector();</instruction>
					<instruction>		}</instruction>
					<instruction>		mapLabelToTabVec(label).push_back(tab);</instruction>
					<instruction>	}</instruction>
					<instruction />
					<instruction>	var vecLabels = DOpus.Create.Vector();</instruction>
					<instruction />
					<instruction>	for (var eLabels = new Enumerator(setLabels); !eLabels.atEnd(); eLabels.moveNext())</instruction>
					<instruction>	{</instruction>
					<instruction>		vecLabels.push_back(eLabels.item());</instruction>
					<instruction>	}</instruction>
					<instruction>	vecLabels.sort();</instruction>
					<instruction />
					<instruction>	cmd.Clear();</instruction>
					<instruction>	var tabPos = 0;</instruction>
					<instruction />
					<instruction>	for (var eLabels = new Enumerator(vecLabels); !eLabels.atEnd(); eLabels.moveNext())</instruction>
					<instruction>	{</instruction>
					<instruction>		var vecTabs = mapLabelToTabVec(eLabels.item());</instruction>
					<instruction>		for (var eTabs = new Enumerator(vecTabs); !eTabs.atEnd(); eTabs.moveNext())</instruction>
					<instruction>		{</instruction>
					<instruction>			var tab = eTabs.item();</instruction>
					<instruction>			cmd.AddLine(&quot;Go TABPOS=&quot; + tabPos + &quot;,&quot; + tab);</instruction>
					<instruction>			++tabPos;</instruction>
					<instruction>		}</instruction>
					<instruction>	}</instruction>
					<instruction />
					<instruction>	if (tabPos &gt; 1)</instruction>
					<instruction>	{</instruction>
					<instruction>		cmd.Run();</instruction>
					<instruction>	}</instruction>
					<instruction>}</instruction>
				</function>
			</button>
			<button backcol="none" display="both" hotkey_label="yes" label_pos="right" textcol="none">
				<label>&amp;Go To Root</label>
				<icon1>#goup</icon1>
				<function type="normal">
					<instruction>Go ROOT USEQUALKEYS</instruction>
				</function>
			</button>
			<button backcol="none" display="both" hotkey_label="yes" label_pos="right" textcol="none">
				<label>Go to &amp;Initial Folder</label>
				<tip>Navigate back to the initial folder where this tab was opened</tip>
				<hotkeys>
					<chord>
						<key>tab</key>
						<key>home</key>
					</chord>
				</hotkeys>
				<icon1>#goback</icon1>
				<function type="normal">
					<instruction>//Go INITIALDIR</instruction>
					<instruction>//Go TABSELECT home </instruction>
					<instruction>//Go TABLOCKDIR</instruction>
					<instruction>Go HOMEDIR USEQUALKEYS</instruction>
				</function>
			</button>
			<button backcol="none" display="both" hotkey_label="yes" label_pos="right" textcol="none">
				<label>&amp;Go to Locked Folder</label>
				<tip>Navigate to the locked home path of this tab</tip>
				<icon1>#formatlock</icon1>
				<function type="normal">
					<instruction>Go TABLOCKDIR</instruction>
				</function>
			</button>
			<button backcol="none" display="both" label_pos="right" textcol="none">
				<label>Copy All Tab Pat&amp;hs</label>
				<icon1>#clipcopy</icon1>
				<function type="script">
					<instruction>@script JScript</instruction>
					<instruction>function OnClick(clickData)</instruction>
					<instruction>{</instruction>
					<instruction>	var lister = clickData.func.sourcetab.lister;</instruction>
					<instruction>	var fsu = DOpus.FSUtil;</instruction>
					<instruction>	var clip = &quot;&quot;;</instruction>
					<instruction>	for (var eTabs = new Enumerator(lister.tabs); !eTabs.atEnd(); eTabs.moveNext())</instruction>
					<instruction>	{</instruction>
					<instruction>		var path = fsu.Resolve(eTabs.item().path);</instruction>
					<instruction>		clip += path + &quot;\n&quot;;</instruction>
					<instruction>	}</instruction>
					<instruction>	DOpus.SetClip(clip);</instruction>
					<instruction>}</instruction>
				</function>
			</button>
			<button backcol="none" display="both" label_pos="right" separate="yes" textcol="none">
				<label>Create Shortcuts for All Tabs</label>
				<tip>Create shortcuts in destination for all folder tabs in the source pane</tip>
				<icon1>#clippasteshortcut</icon1>
				<function type="script">
					<instruction>@script JScript</instruction>
					<instruction>function OnClick(clickData)</instruction>
					<instruction>{</instruction>
					<instruction>	var cmd = clickData.func.command;</instruction>
					<instruction>	cmd.deselect = false;</instruction>
					<instruction>	var fsu = DOpus.FSUtil;</instruction>
					<instruction>	var lister = clickData.func.sourcetab.lister;</instruction>
					<instruction>	var tabs = lister.tabsleft;</instruction>
					<instruction>	if (clickData.func.sourcetab.right) </instruction>
					<instruction>		tabs = lister.tabsright;</instruction>
					<instruction>	</instruction>
					<instruction>	//dopusrt /info /desktop\pathlist.txt,paths</instruction>
					<instruction>	//Copy C:\123 MAKELINK TO /desktop</instruction>
					<instruction>	for (var eTabs = new Enumerator(tabs); !eTabs.atEnd(); eTabs.moveNext())</instruction>
					<instruction>	{</instruction>
					<instruction>		var path = fsu.Resolve(eTabs.item().path);</instruction>
					<instruction>		cmd.AddLine(&apos;Copy &quot;&apos;+path+&apos;&quot; MAKELINK WHENEXISTS=skip&apos;);</instruction>
					<instruction>	}</instruction>
					<instruction>	cmd.Run;</instruction>
					<instruction>}</instruction>
				</function>
			</button>
		</button>
<button backcol="none" display="both" label_pos="right" textcol="none" type="menu">
			<label>Select (&amp;X)</label>
